# ================================================================
# Aether - required API keys
# Copy this file to `.env` and fill in real values.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
# NEVER commit your real .env to version control.
# ================================================================

# Groq console: https://console.groq.com/keys  -> used for the Planner,
# Document Analyst and Writer agents (model: openai/gpt-oss-20b)
GROQ_API_KEY=gsk_your_key_here

# Tavily: https://app.tavily.com/ -> powers the live web Researcher agent
TAVILY_API_KEY=tvly-your_key_here

# Optional (not required by Aether itself, but used elsewhere):
# HUGGINGFACEHUB_ACCESS_TOKEN=hf_your_token_here   # higher HF Hub rate limits
# OPENWEATHER_API_KEY=your_key_here
# GOOGLE_API_KEY=your_key_here
